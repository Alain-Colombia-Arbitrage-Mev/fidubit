---
/**
 * TRACKWISE - Home Page (Portuguese)
 */
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/layout/Header.astro';
import Sidebar from '@/components/layout/Sidebar.astro';
import Footer from '@/components/layout/Footer.astro';
import Hero from '@/components/sections/Hero.astro';
import CardsSection from '@/components/sections/CardsSection.astro';
import InfrastructureSection from '@/components/sections/InfrastructureSection.astro';
import StaffTeaser from '@/components/sections/StaffTeaser.astro';
import TeamSection from '@/components/sections/TeamSection.astro';
import MusicSection from '@/components/sections/MusicSection.astro';
import CorporateSection from '@/components/sections/CorporateSection.astro';
import ContactSection from '@/components/sections/ContactSection.astro';
import WhatsAppButton from '@/components/ui/WhatsAppButton.astro';

const seo = {
  title: 'TRACKWISE - Fintech BaaS, Cartões e Pagamentos Globais',
  description: 'Trackwise LLC (Wyoming, EUA - MSB #31000299058422). Plataforma Banking-as-a-Service: emissão de cartões, contas multi-moeda, pagamentos cross-border e APIs financeiras embarcadas.',
  keywords: ['fintech baas', 'banking as a service', 'emissão de cartões', 'wyoming msb', 'blockchain', 'staff augmentation', 'desenvolvimento fintech'],
};
---

<Layout seo={seo} lang="pt">
  <WhatsAppButton />
  <Header />
  
  <main class="relative z-10 flex-1 flex flex-col md:flex-row pt-16">
    <Sidebar />
    <div class="flex-1 flex flex-col min-w-0 md:ml-16 relative">
      <Hero />
      <CardsSection />
      <InfrastructureSection />
      <StaffTeaser />
      <TeamSection />
      <MusicSection />
      <CorporateSection />
      <ContactSection />
      <Footer />
    </div>
  </main>
</Layout>

<script>
  const observerOptions: IntersectionObserverInit = {
    root: null,
    rootMargin: '0px',
    threshold: 0.1
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('sys-active');
        observer.unobserve(entry.target);
      }
    });
  }, observerOptions);

  document.querySelectorAll('.sys-reveal').forEach(el => {
    observer.observe(el);
  });
</script>

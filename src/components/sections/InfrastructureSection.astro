---
/**
 * TRACKWISE - Infrastructure Section
 * Fintech, Blockchain, and OTC services
 */
import ModuleTag from '@/components/ui/ModuleTag.astro';
import GlassPanel from '@/components/ui/GlassPanel.astro';
import { infrastructureServices } from '@/data/site';
import { getLangFromUrl, useTranslations } from '@/i18n';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Translated service content
const serviceTranslations: Record<string, Record<string, { title: string; description: string; features: string[] }>> = {
  en: {
    fintech: {
      title: 'Fintech Engineering',
      description: 'Fintech engineering: white-label account/IBAN provisioning through partners, ACH/SEPA integration, and a real-time ledger built for fintech operators.',
      features: ['White-label UI / UX', 'API-first architecture', 'Real-time ledger primitives', 'Multi-tenant infrastructure'],
    },
    blockchain: {
      title: 'Blockchain Engineering',
      description: 'Smart-contract engineering services: asset tokenization, stablecoin integration, and partner-custodian wallet integration. Trackwise does not custody customer assets.',
      features: ['Tokenization engineering', 'Stablecoin integration', 'Partner-custodian integration'],
    },
    otc: {
      title: 'Crypto OTC (via partners)',
      description: 'Fiat/crypto on- and off-ramp connectivity through licensed exchange and OTC partners. Pricing and settlement depend on the partner. Trackwise does not act as a counterparty.',
      features: ['Partner-routed liquidity', 'Compliance pre-screening', 'Settlement via partner banks'],
    },
  },
  es: {
    fintech: {
      title: 'Ingeniería Fintech',
      description: 'Ingeniería fintech: provisión de cuentas/IBAN white-label a través de partners, integración ACH/SEPA y un ledger en tiempo real construido para operadores fintech.',
      features: ['Diseño UI / UX white-label', 'Arquitectura API-first', 'Primitivas de ledger en tiempo real', 'Infraestructura multi-tenant'],
    },
    blockchain: {
      title: 'Ingeniería Blockchain',
      description: 'Servicios de ingeniería de smart contracts: tokenización de activos, integración de stablecoins e integración con wallets de custodios partner. Trackwise no custodia activos del cliente.',
      features: ['Ingeniería de tokenización', 'Integración stablecoin', 'Integración con custodios partner'],
    },
    otc: {
      title: 'Cripto OTC (vía partners)',
      description: 'Conectividad de rampas fiat/cripto a través de partners de exchange y OTC licenciados. Precios y liquidación dependen del partner. Trackwise no es contraparte.',
      features: ['Liquidez enrutada por partners', 'Pre-screening de compliance', 'Liquidación vía bancos partner'],
    },
  },
  pt: {
    fintech: {
      title: 'Engenharia Fintech',
      description: 'Engenharia fintech: provisão de contas/IBAN white-label através de parceiros, integração ACH/SEPA e ledger em tempo real construído para operadores fintech.',
      features: ['Design UI / UX white-label', 'Arquitetura API-first', 'Primitivas de ledger em tempo real', 'Infraestrutura multi-tenant'],
    },
    blockchain: {
      title: 'Engenharia Blockchain',
      description: 'Serviços de engenharia de smart contracts: tokenização de ativos, integração de stablecoins e integração com wallets de custodiantes parceiros. Trackwise não custodia ativos do cliente.',
      features: ['Engenharia de tokenização', 'Integração stablecoin', 'Integração com custodiantes parceiros'],
    },
    otc: {
      title: 'Cripto OTC (via parceiros)',
      description: 'Conectividade de rampas fiat/cripto através de parceiros de exchange e OTC licenciados. Preços e liquidação dependem do parceiro. Trackwise não atua como contraparte.',
      features: ['Liquidez roteada por parceiros', 'Pré-screening de compliance', 'Liquidação via bancos parceiros'],
    },
  },
  zh: {
    fintech: {
      title: '金融科技工程',
      description: '金融科技工程：通过合作伙伴提供白标账户/IBAN、ACH/SEPA 集成，以及为金融科技运营商打造的实时账本。',
      features: ['白标 UI / UX', 'API 优先架构', '实时账本原语', '多租户基础设施'],
    },
    blockchain: {
      title: '区块链工程',
      description: '智能合约工程服务：资产代币化、稳定币集成、与合作托管方的钱包集成。Trackwise 不托管客户资产。',
      features: ['代币化工程', '稳定币集成', '合作托管方集成'],
    },
    otc: {
      title: '加密 OTC (通过合作伙伴)',
      description: '通过持牌交易所和 OTC 合作伙伴提供法币/加密的入金和出金连接。定价和结算取决于合作伙伴。Trackwise 不作为交易对手方。',
      features: ['合作伙伴路由流动性', '合规预筛查', '通过合作银行结算'],
    },
  },
  ar: {
    fintech: {
      title: 'هندسة التكنولوجيا المالية',
      description: 'هندسة فينتك: توفير حسابات/IBAN بعلامة بيضاء عبر الشركاء، وتكامل ACH/SEPA، ودفتر أستاذ في الوقت الفعلي مبني لمشغلي الفينتك.',
      features: ['تصميم UI/UX بعلامة بيضاء', 'بنية API-first', 'بدائيات دفتر الأستاذ في الوقت الفعلي', 'بنية تحتية متعددة المستأجرين'],
    },
    blockchain: {
      title: 'هندسة البلوكتشين',
      description: 'خدمات هندسة العقود الذكية: ترميز الأصول، وتكامل العملات المستقرة، وتكامل المحافظ مع الحفظة الشركاء. لا تحتفظ Trackwise بأصول العملاء.',
      features: ['هندسة الترميز', 'تكامل العملات المستقرة', 'تكامل مع الحفظة الشركاء'],
    },
    otc: {
      title: 'كريبتو OTC (عبر الشركاء)',
      description: 'الاتصال برامبات النقد/الكريبتو عبر شركاء تبادل و OTC مرخصين. التسعير والتسوية يعتمدان على الشريك. Trackwise ليست طرفًا مقابلًا.',
      features: ['سيولة موجهة من الشركاء', 'فحص امتثال مسبق', 'تسوية عبر بنوك شركاء'],
    },
  },
};

const currentTranslations = serviceTranslations[lang] || serviceTranslations.en;

const colorClasses = {
  blue: {
    bg: 'bg-blue-500/10',
    text: 'text-blue-500',
    border: 'border-blue-500/20',
    badge: 'border-blue-500/30 text-blue-400 bg-blue-500/5',
    hover: 'from-transparent to-blue-900/5',
  },
  purple: {
    bg: 'bg-purple-500/10',
    text: 'text-purple-500',
    border: 'border-purple-500/20',
    badge: 'border-purple-500/30 text-purple-400 bg-purple-500/5',
    hover: 'from-transparent to-purple-900/5',
  },
  green: {
    bg: 'bg-green-500/10',
    text: 'text-green-500',
    border: 'border-green-500/20',
    badge: 'border-green-500/30 text-green-400 bg-green-500/5',
    hover: 'from-transparent to-green-900/5',
  },
  yellow: {
    bg: 'bg-yellow-500/10',
    text: 'text-yellow-500',
    border: 'border-yellow-500/20',
    badge: 'border-yellow-500/30 text-yellow-400 bg-yellow-500/5',
    hover: 'from-transparent to-yellow-900/5',
  },
  fuchsia: {
    bg: 'bg-fuchsia-500/10',
    text: 'text-fuchsia-500',
    border: 'border-fuchsia-500/20',
    badge: 'border-fuchsia-500/30 text-fuchsia-400 bg-fuchsia-500/5',
    hover: 'from-transparent to-fuchsia-900/5',
  },
};
---

<section id="section-infra" class="relative border-b border-white/5 bg-trackwise-dark">
  <!-- Module Tag -->
  <div class="absolute top-0 right-0 p-4 z-20">
    <ModuleTag number="02" />
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3">
    {infrastructureServices.map((service, index) => {
      const colors = colorClasses[service.accentColor];
      const delayClass = index === 0 ? '' : index === 1 ? 'sys-delay-100' : 'sys-delay-200';
      
      return (
        <article 
          class:list={[
            "group relative border-r border-b lg:border-b-0 border-white/5 p-10 h-auto min-h-[420px]",
            "flex flex-col justify-between hover:bg-white/5 transition-colors sys-reveal sys-rise",
            delayClass
          ]}
        >
          <!-- Hover Gradient -->
          <div 
            class:list={[
              "absolute inset-0 bg-gradient-to-b opacity-0 group-hover:opacity-100 transition-opacity duration-500",
              colors.hover
            ]}
            aria-hidden="true"
          ></div>
          
          <!-- Dot Pattern Background -->
          <div class="absolute inset-0 dot-pattern" aria-hidden="true"></div>
          
          <!-- Header -->
          <div class="flex justify-between items-start relative z-10">
            <div class:list={["p-3 rounded-lg border", colors.bg, colors.text, colors.border]}>
              <iconify-icon icon={service.icon} width="28"></iconify-icon>
            </div>
            <span class="text-[10px] font-mono text-zinc-600">{service.tag}</span>
          </div>
          
          <!-- Content -->
          <div class="relative z-10 mt-auto">
            {(() => {
              const key = service.tag === 'INFRA_DEV' ? 'fintech' : service.tag === 'WEB3_LAYER' ? 'blockchain' : 'otc';
              const trans = currentTranslations[key];
              return (
                <>
                  <h3 class="text-xl font-medium text-white uppercase tracking-tight mb-3">
                    {trans.title}
                  </h3>
                  <p class="text-xs text-zinc-500 font-mono leading-relaxed mb-4">
                    {trans.description}
                  </p>
                  <ul class="space-y-2 mb-4">
                    {trans.features.map((feature) => (
                      <li class="flex items-center text-[10px] font-mono text-zinc-400 gap-2">
                        <iconify-icon icon="solar:check-circle-linear" class={colors.text}></iconify-icon>
                        {feature}
                      </li>
                    ))}
                  </ul>
                </>
              );
            })()}
            
            <!-- Badges -->
            {service.badges && (
              <div class="flex gap-2 mt-2 flex-wrap">
                {service.badges.map((badge) => (
                  <span class:list={["text-[9px] border px-2 py-1 rounded", colors.badge]}>
                    {badge}
                  </span>
                ))}
              </div>
            )}
            
            <!-- Partner note for OTC service -->
            {service.tag === 'LIQUIDITY' && (
              <GlassPanel padding="sm" rounded="md" class="mt-4 border border-white/10">
                <p class="text-[10px] font-mono text-zinc-500 leading-relaxed">
                  Operated through licensed partner exchanges. Trackwise is not a counterparty.
                </p>
              </GlassPanel>
            )}
          </div>
        </article>
      );
    })}
  </div>
</section>

---
/**
 * TRACKWISE - Team Section
 * Leadership / core team of Trackwise LLC
 */
import GlassPanel from '@/components/ui/GlassPanel.astro';
import SectionLabel from '@/components/ui/SectionLabel.astro';
import ModuleTag from '@/components/ui/ModuleTag.astro';
import { teamMembers } from '@/data/site';
import { getLangFromUrl, useTranslations } from '@/i18n';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const accentMap: Record<string, { text: string; bg: string; border: string; ring: string }> = {
  yellow:  { text: 'text-yellow-400',  bg: 'bg-yellow-500/10',  border: 'border-yellow-500/30',  ring: 'hover:border-yellow-500/50' },
  blue:    { text: 'text-blue-400',    bg: 'bg-blue-500/10',    border: 'border-blue-500/30',    ring: 'hover:border-blue-500/50' },
  green:   { text: 'text-green-400',   bg: 'bg-green-500/10',   border: 'border-green-500/30',   ring: 'hover:border-green-500/50' },
  purple:  { text: 'text-purple-400',  bg: 'bg-purple-500/10',  border: 'border-purple-500/30',  ring: 'hover:border-purple-500/50' },
  fuchsia: { text: 'text-fuchsia-400', bg: 'bg-fuchsia-500/10', border: 'border-fuchsia-500/30', ring: 'hover:border-fuchsia-500/50' },
};
---

<section
  id="section-team"
  class="relative border-b border-white/5 bg-trackwise-black py-20 overflow-hidden"
>
  <!-- Module Tag -->
  <div class="absolute top-0 right-0 p-4 z-20">
    <ModuleTag number="06" />
  </div>

  <!-- Subtle Background -->
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,rgba(34,197,94,0.05)_0%,transparent_55%)]"></div>
  <div class="absolute inset-0 dot-pattern opacity-20"></div>

  <div class="max-w-7xl mx-auto px-6 lg:px-12 relative z-10">
    <!-- Header -->
    <div class="mb-12">
      <SectionLabel icon="solar:user-id-linear" color="green">
        {t.team.label}
      </SectionLabel>

      <h2 class="text-4xl lg:text-5xl font-medium text-white uppercase tracking-tight leading-none mt-6 mb-4 sys-reveal sys-rise">
        {t.team.title}
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-green-400 to-blue-400 block">
          {t.team.titleHighlight}
        </span>
      </h2>

      <p class="text-sm text-zinc-500 font-mono leading-relaxed max-w-2xl sys-reveal sys-rise sys-delay-100">
        {t.team.description}
      </p>
    </div>

    <!-- Team Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {teamMembers.map((member, idx) => {
        const accent = accentMap[member.accentColor || 'green'];
        const delayClass = idx === 0 ? 'sys-delay-100' : 'sys-delay-200';

        return (
          <GlassPanel
            padding="lg"
            rounded="xl"
            class={`border ${accent.border} ${accent.ring} transition-all duration-300 sys-reveal sys-rise ${delayClass}`}
          >
            <div class="flex items-start gap-5">
              <!-- Avatar / Icon -->
              <div class={`w-14 h-14 shrink-0 rounded-xl flex items-center justify-center ${accent.bg} border ${accent.border}`}>
                <iconify-icon
                  icon={member.icon || 'solar:user-linear'}
                  width="26"
                  class={accent.text}
                ></iconify-icon>
              </div>

              <!-- Info -->
              <div class="flex-1 min-w-0">
                <h3 class="text-xl font-medium text-white tracking-tight">
                  {member.name}
                </h3>
                <div class={`text-[11px] font-mono uppercase tracking-widest mt-1 ${accent.text}`}>
                  {member.role}
                </div>

                {member.bio && (
                  <p class="text-xs text-zinc-500 font-mono leading-relaxed mt-4">
                    {member.bio}
                  </p>
                )}

                {member.skills && member.skills.length > 0 && (
                  <div class="flex flex-wrap gap-2 mt-5">
                    {member.skills.map((skill) => (
                      <span class="text-[10px] border border-white/10 text-zinc-400 px-2 py-1 rounded bg-white/5 font-mono">
                        {skill}
                      </span>
                    ))}
                  </div>
                )}

                {member.socials && (
                  <div class="flex items-center gap-3 mt-5 pt-4 border-t border-white/5">
                    {member.socials.email && (
                      <a
                        href={`mailto:${member.socials.email}`}
                        class={`flex items-center gap-1.5 text-[11px] font-mono text-zinc-500 hover:${accent.text} transition-colors`}
                        aria-label={`Email ${member.name}`}
                      >
                        <iconify-icon icon="solar:letter-linear" width="14"></iconify-icon>
                        {member.socials.email}
                      </a>
                    )}
                    {member.socials.linkedin && (
                      <a
                        href={member.socials.linkedin}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-zinc-500 hover:text-white transition-colors"
                        aria-label={`LinkedIn ${member.name}`}
                      >
                        <iconify-icon icon="ri:linkedin-line" width="16"></iconify-icon>
                      </a>
                    )}
                    {member.socials.github && (
                      <a
                        href={member.socials.github}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-zinc-500 hover:text-white transition-colors"
                        aria-label={`GitHub ${member.name}`}
                      >
                        <iconify-icon icon="ri:github-line" width="16"></iconify-icon>
                      </a>
                    )}
                    {member.socials.twitter && (
                      <a
                        href={member.socials.twitter}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-zinc-500 hover:text-white transition-colors"
                        aria-label={`Twitter ${member.name}`}
                      >
                        <iconify-icon icon="ri:twitter-x-line" width="14"></iconify-icon>
                      </a>
                    )}
                  </div>
                )}
              </div>
            </div>
          </GlassPanel>
        );
      })}
    </div>
  </div>
</section>

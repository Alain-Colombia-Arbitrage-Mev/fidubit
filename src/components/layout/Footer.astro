---
/**
 * TRACKWISE - Footer Component
 * Site footer with legal links
 */
import { siteConfig, footerLinks, msbDisclaimer } from '@/data/site';
import { getLangFromUrl, useTranslations } from '@/i18n';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;

// Get translations
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<footer 
  class:list={[
    "border-t border-white/5 bg-trackwise-darker py-12 px-8 mt-auto",
    className
  ]}
>
  <div class="max-w-7xl mx-auto">
    <!-- Main Footer Content -->
    <div class="flex flex-col lg:flex-row justify-between items-start lg:items-center gap-8 mb-12">
      <!-- Brand -->
      <div class="space-y-4">
        <div class="flex items-center gap-2">
          <div class="w-2 h-2 bg-yellow-500 rounded-none shadow-[0_0_10px_rgba(234,179,8,0.4)]"></div>
          <span class="text-lg font-bold text-white tracking-tight">{siteConfig.name}</span>
        </div>
        <p class="text-xs text-zinc-600 font-mono max-w-xs leading-relaxed">
          {t.hero.description}
        </p>
      </div>
      
      <!-- Services Quick Links -->
      <div class="grid grid-cols-2 gap-x-12 gap-y-3">
        <span class="text-[10px] font-mono text-zinc-500 uppercase tracking-widest col-span-2 mb-2">{t.footer.services}</span>
        <a href="#section-cards" class="text-xs text-zinc-500 hover:text-yellow-500 transition-colors font-mono">{t.nav.cards}</a>
        <a href="#section-infra" class="text-xs text-zinc-500 hover:text-yellow-500 transition-colors font-mono">{t.nav.softwareDev}</a>
        <a href="/ai" class="text-xs text-zinc-500 hover:text-purple-500 transition-colors font-mono">{t.nav.ai}</a>
        <a href="/remittance" class="text-xs text-zinc-500 hover:text-yellow-500 transition-colors font-mono">{t.nav.remittance}</a>
        <a href="/staff" class="text-xs text-zinc-500 hover:text-blue-500 transition-colors font-mono">{t.nav.staff}</a>
        <a href="/#section-team" class="text-xs text-zinc-500 hover:text-green-500 transition-colors font-mono">{t.nav.team}</a>
        <a href="/apps" class="text-xs text-zinc-500 hover:text-blue-500 transition-colors font-mono">Apps</a>
        <a href="#section-music" class="text-xs text-zinc-500 hover:text-fuchsia-500 transition-colors font-mono">{t.nav.media}</a>
      </div>
      
      <!-- Contact Info -->
      <div class="space-y-3">
        <span class="text-[10px] font-mono text-zinc-500 uppercase tracking-widest block mb-2">Contact</span>
        <a 
          href={`mailto:${siteConfig.email}`}
          class="flex items-center gap-2 text-xs text-zinc-500 hover:text-yellow-500 transition-colors font-mono"
        >
          <iconify-icon icon="solar:letter-linear" class="text-zinc-600"></iconify-icon>
          {siteConfig.email}
        </a>
        <a 
          href={`https://wa.me/${siteConfig.whatsapp.replace(/\s/g, '')}`}
          class="flex items-center gap-2 text-xs text-zinc-500 hover:text-green-500 transition-colors font-mono"
        >
          <iconify-icon icon="logos:whatsapp-icon" width="14" class="grayscale opacity-50"></iconify-icon>
          {siteConfig.whatsapp}
        </a>
        <div class="flex items-start gap-2 text-xs text-zinc-600 font-mono leading-relaxed">
          <iconify-icon icon="solar:map-point-linear" class="text-zinc-600 mt-0.5"></iconify-icon>
          <span>
            {siteConfig.addressLine1}<br />
            {siteConfig.addressLine2}<br />
            {siteConfig.country}
          </span>
        </div>
      </div>
    </div>

    <!-- MSB Scope Disclaimer -->
    <div class="mb-8 p-4 border border-white/5 rounded-md bg-white/[0.02]">
      <div class="flex items-start gap-3">
        <iconify-icon
          icon="solar:info-circle-linear"
          class="text-yellow-500/70 mt-0.5 shrink-0"
          width="16"
        ></iconify-icon>
        <p class="text-[11px] text-zinc-500 font-mono leading-relaxed">
          {msbDisclaimer}
          <a
            href="https://www.fincen.gov/msb-registrant-search"
            target="_blank"
            rel="noopener noreferrer"
            class="text-yellow-500/70 hover:text-yellow-500 ml-1"
          >
            Verify on FinCEN →
          </a>
        </p>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 border-t border-white/5 flex flex-col md:flex-row justify-between items-center gap-6">
      <div class="text-xs text-zinc-600 font-mono">
        &copy; {siteConfig.year} {siteConfig.legalName}. {t.footer.rights}
        <span class="block mt-1 text-zinc-700">Wyoming, USA · FinCEN MSB #31000299058422</span>
      </div>
      
      <!-- Legal Links -->
      <div class="flex gap-6">
        {footerLinks.map((link) => (
          <a 
            href={link.href} 
            class="text-zinc-600 hover:text-yellow-500 transition-colors text-xs uppercase font-mono"
          >
            {link.label}
          </a>
        ))}
      </div>
      
      <!-- Compliance contact -->
      <div class="flex items-center gap-3 text-[10px] text-zinc-600 font-mono">
        <a
          href={`mailto:${siteConfig.compliance}`}
          class="hover:text-yellow-500 transition-colors"
        >
          {siteConfig.compliance}
        </a>
      </div>
    </div>
  </div>
</footer>
